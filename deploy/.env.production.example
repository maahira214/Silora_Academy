# Production settings for deploy/compose.yaml. Copy to deploy/.env on the server
# (setup-server.sh does this and fills in the generated secrets). Never commit deploy/.env.

# Address of the app. DNS for this name must point at the server (ask the website developer).
APP_DOMAIN="app.siloraacademy.com"
APP_URL="https://app.siloraacademy.com"

# Generated by setup-server.sh (letters and numbers only).
POSTGRES_PASSWORD=""
CRON_SECRET=""

# Google sign-in: OAuth client (Web application) with redirect URI
# https://app.siloraacademy.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare R2: one private bucket holds chat files (uploads/) and database backups (backups/).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="silora-files"

# Sentry error alerts (free plan). The same DSN goes in both lines; leave empty to turn alerts off.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"

# Must stay false in production (the seeded-user login is also hard-disabled in production builds).
DEV_LOGIN="false"
