# Local development settings. Never commit real secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/silora"
APP_URL="http://localhost:3000"

# Shows a "sign in as a seeded user" panel on /login. Never enable in production.
DEV_LOGIN="true"

# Google sign-in (OAuth client from Google Cloud Console). Leave empty until configured.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shared secret for the scheduler endpoint (/api/cron/tick)
CRON_SECRET=""

# Where chat files and database backups go: "local" (this computer, development) or "r2" (Cloudflare R2, production only).
# Switching to R2 later needs only these settings; no code changes.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
BACKUP_DIR="./backups"
# Folder containing pg_dump/pg_restore (PostgreSQL 17+). Leave empty: found automatically on Windows or on PATH
PG_BIN=""
# Production only; leave empty for local development.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Email for class changes and cancellations: "log" (development, never sends; read them under Admin > More > Emails)
# or "resend" (production). RESEND_API_KEY and EMAIL_FROM are production only.
EMAIL_DRIVER="log"
RESEND_API_KEY=""
EMAIL_FROM=""
EMAIL_DAILY_LIMIT="95"
